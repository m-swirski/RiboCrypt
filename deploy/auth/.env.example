# Select maintained releases and pin image tags/digests before deployment.
KEYCLOAK_IMAGE=
POSTGRES_IMAGE=
OAUTH2_PROXY_IMAGE=
LOGIN_HOST=login.example.org
APP_HOST=ribocrypt.org
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
RIBOCRYPT_OIDC_CLIENT_SECRET=
# 32 random bytes encoded as URL-safe base64 (ordinary base64 can fail).
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '\n'
OAUTH2_PROXY_COOKIE_SECRET=
# 64 hex characters from openssl rand -hex 32; same value in Shiny and NGINX.
RIBOCRYPT_GATEWAY_SECRET=
