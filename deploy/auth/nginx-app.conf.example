# Include inside the existing HTTPS app server block. Replace backend port and
# install shiny-proxy.conf/gateway-secret.conf in /etc/nginx/ribocrypt/.
# Keep this alongside ALL existing server-level add_header directives. On NGINX
# <1.29.3, repeat any http-level headers here too: inheritance is all-or-nothing.
add_header Set-Cookie $ribocrypt_refresh_cookie always;
location = /_ribocrypt_auth {
    internal;
    proxy_pass http://127.0.0.1:4180/oauth2/auth;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Original-URL $scheme://$host$request_uri;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Host $host;
}
location /oauth2/ {
    proxy_pass http://127.0.0.1:4180;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Real-IP $remote_addr;
}
location = /ribocrypt/logout {
    return 302 /oauth2/sign_out?rd=/;
}
location / {
    auth_request /_ribocrypt_auth;
    auth_request_set $ribocrypt_subject $upstream_http_x_auth_request_user;
    auth_request_set $ribocrypt_refresh_cookie $upstream_http_set_cookie;
    error_page 401 = @ribocrypt_public;
    include /etc/nginx/ribocrypt/shiny-proxy.conf;
}
location @ribocrypt_public {
    set $ribocrypt_subject "";
    include /etc/nginx/ribocrypt/shiny-proxy.conf;
}
